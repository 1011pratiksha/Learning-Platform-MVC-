@model LearningAppMVC.Models.Subscriptions

@{
    ViewBag.Title = "Modal";
}


@{
    Html.BeginForm("Modal", "Home");
}


<h1>Add Subscription</h1>

@Html.Label("Subscription Name") &nbsp;@Html.TextBoxFor(x => x.sub_type)
@*@Html.ValidationMessage(x => x.sub_type)*@
<br />
<br />
@Html.Label("Master Course Name") &nbsp;@Html.DropDownListFor(x => x.mid, new SelectList(new[] { 1, 2 }), "Select Master Course")
<br />
<br />
@Html.Label("Sub Course") &nbsp;@Html.DropDownListFor(x => x.sid, new SelectList(new[] { 1, 2 }), "Select Sub Course")
<br />
<br />
@Html.Label("Amount") &nbsp;@Html.TextBoxFor(x => x.sub_amount)
@*@Html.ValidationMessage(x => x.sub_amount)*@
<br />
<br />
@Html.Label("Status") &nbsp;@Html.DropDownListFor(x => x.subStatus, new SelectList(new[] { "Active", "Inactive" }), "Select Status")
<br />
<br />
@Html.Label("Thumbnail") &nbsp;
<input type="file" name="subThumbnail" />
<br />
<br />
<input type="submit" value="Add" />
<br />
<br />
@Html.ActionLink("Back To List", "Index")



@{
    Html.EndForm();
}

