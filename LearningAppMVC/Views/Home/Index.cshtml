@model IEnumerable<LearningAppMVC.Models.Subscriptions>
@{
    ViewBag.Title = "Index";
}

<h1>Add Subscription</h1>

@*@Html.Raw(TempData["InsertMessage"])*@

<p style="color:green;">@TempData["InsertMessage"]</p>
<p style="color:green;">@TempData["UpdatetMessage"]</p>
<p style="color:green;">@TempData["DeleteMessage"]</p>

@Html.ActionLink("Create New", "Modal")

<table border="2">
    <tr>
        <th>ID</th>
        <th>Sub Type</th>
        <th>Master Course</th>
        <th>Sub Master Course</th>
        <th>Sub Amount</th>
        <th>status</th>
        <th>Thumbnail</th>
        <th>Action</th>

    </tr>
    @{
        foreach (var item in Model)
        {
            <tr>
                <td>@item.sub_id</td>
                <td>@item.sub_type</td>
                <td>@item.mid</td>
                <td>@item.sid</td>
                <td>@item.sub_amount</td>
                <td>@item.subStatus</td>
                <td>@item.subThumbnail</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.sub_id })
                    |
                    @Html.ActionLink("Delete", "Delete", new { id = item.sub_id })
                </td>

            </tr>
        }
    }

</table>
