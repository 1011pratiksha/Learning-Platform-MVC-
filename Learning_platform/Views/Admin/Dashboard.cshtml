@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 bg-dark text-white min-vh-100 p-3">

            <h4 class="mb-4">Admin Panel</h4>

            <div class="nav flex-column">

                <a class="nav-link text-white" href="#">
                    Master Course
                </a>

                <a class="nav-link text-white" href="#">
                    Sub Course
                </a>

                <a class="nav-link text-white" href="#">
                    Add Topic
                </a>

                <a class="nav-link text-white" href="#">
                    Add Material
                </a>

                <a class="nav-link text-white" href="#">
                    Add Subscription
                </a>

            </div>

        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 p-4">

            <h2>Admin Dashboard</h2>

            <p class="text-muted">
                Welcome to the Learning Platform Admin Panel.
            </p>

            <div class="row mt-4">

                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Master Courses</h5>
                            <p class="card-text">
                                Manage master courses.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Sub Courses</h5>
                            <p class="card-text">
                                Manage sub courses.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Subscriptions</h5>
                            <p class="card-text">
                                Manage subscriptions.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>