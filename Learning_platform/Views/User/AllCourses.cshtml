@model List<Learning_platform.Models.SubCourse>

<div class="container mt-4">

    <h2 class="mb-4">All Courses</h2>

    <div class="mb-4">
        <a asp-controller="User"
           asp-action="Cart"
           class="btn btn-outline-primary">
            🛒 Cart (@ViewBag.CartCount)
        </a>
    </div>

    <!-- Course Type Selection -->
    <div class="mb-4">
        <label class="me-3">
            <input type="checkbox" id="masterCourseCheck">
            Master Course
        </label>

        <label>
            <input type="checkbox" id="subCourseCheck">
            Sub Course
        </label>
    </div>

    <!-- Master Courses -->
    <div id="masterCourses" class="row">

        @foreach (var master in ViewBag.MasterCourses)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <!-- Jui's Master Course Thumbnail -->
                    <img src="@master.ThumbnailPath"
                         class="card-img-top"
                         alt="@master.CourseName"
                         style="height: 180px; object-fit: cover;">

                    <div class="card-body">

                        <h5 class="card-title">
                            @master.CourseName
                        </h5>

                        <a asp-controller="User"
                           asp-action="SubCourses"
                           asp-route-mid="@master.Id"
                           class="btn btn-primary">
                            View Sub Courses
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>