@model List<LearningPlatform.Models.MasterCourse>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Master Course</h2>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#courseModal" onclick="openAddModal()">
            <i class="bi bi-plus-circle"></i> Add Master Course
        </button>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchBox" class="form-control" placeholder="Search master course..." />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-toggle-on"></i></span>
                        <select id="filterStatus" class="form-select">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover align-middle mb-0" id="courseTable" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Master Course</th>
                        <th>Status</th>
                        <th>Thumbnail</th>
                        <th>Created At</th>
                        <th>Created By</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.CourseName</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ThumbnailPath))
                                {
                                    <img src="@item.ThumbnailPath" width="50" height="50" style="object-fit:cover; border-radius:4px;" />
                                }
                            </td>
                            <td>@item.CreatedAt</td>
                            <td>@item.CreatedBy</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" data-bs-toggle="modal" data-bs-target="#courseModal" onclick="editCourse(@item.Id)" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="deleteCourse(@item.Id)" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="courseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"><i class="bi bi-plus-circle me-2"></i>Add Master Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="courseForm">
                    <input type="hidden" id="Id" name="Id" />

                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-journal-text me-1"></i>Master Course</label>
                        <input type="text" class="form-control" id="CourseName" name="CourseName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-toggle-on me-1"></i>Status</label>
                        <select class="form-select" id="Status" name="Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-image me-1"></i>Thumbnail</label>
                        <input type="file" class="form-control" id="thumbnail" name="thumbnail" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary d-flex align-items-center gap-2" onclick="saveCourse()">
                    <i class="bi bi-save"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#courseTable').DataTable({
                order: [[4, 'desc']],          // default sort: Created At, desc
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                columnDefs: [
                    { orderable: false, targets: [3, 6] }   // disable sorting on Thumbnail and Action columns
                ]
            });

            // Global search box
            $('#searchBox').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Filter by Status (column index 2)
            $('#filterStatus').on('change', function () {
                table.column(2).search(this.value).draw();
            });
        });

        function openAddModal() {
            document.getElementById("modalTitle").innerText = "Add Master Course";
            document.getElementById("courseForm").reset();
            document.getElementById("Id").value = "";
        }

        function saveCourse() {
            var id = document.getElementById("Id").value;
            var url = id ? "/MasterCourse/Update" : "/MasterCourse/Add";

            var formData = new FormData(document.getElementById("courseForm"));

            fetch(url, {
                method: "POST",
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert("Something went wrong.");
                }
            });
        }

        function editCourse(id) {
            fetch("/MasterCourse/GetById?id=" + id)
                .then(response => response.json())
                .then(data => {
                    document.getElementById("modalTitle").innerText = "Edit Master Course";
                    document.getElementById("Id").value = data.id;
                    document.getElementById("CourseName").value = data.courseName;
                    document.getElementById("Status").value = data.status;
                });
        }

        function deleteCourse(id) {
            if (confirm("Are you sure you want to delete this course?")) {
                fetch("/MasterCourse/Delete?id=" + id, {
                    method: "POST"
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    }
                });
            }
        }
    </script>
}
