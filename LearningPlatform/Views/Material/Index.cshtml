@model IEnumerable<LearningPlatform.Models.Material>

@{
    ViewData["Title"] = "Material";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Material</h2>
            <p class="text-muted mb-0">
                Manage course materials and MCQ questions.
            </p>
        </div>
    </div>


    <!-- MATERIAL LIST CARD -->
    <div class="card shadow-sm">

        <div class="card-body">

            <!-- SEARCH / FILTER / ADD AREA  -->

            <div class="row align-items-center mb-3">

                <div class="col-md-3 mb-2 mb-md-0">

                    <h5 class="mb-0">
                        Material List
                    </h5>

                </div>


                <!-- Search -->
                <div class="col-md-3 mb-2 mb-md-0">

                    <input type="text"
                           id="searchMaterial"
                           class="form-control"
                           placeholder="Search material..."
                           onkeyup="searchMaterials()" />

                </div>


                <!-- Master Course Filter -->
                <div class="col-md-2 mb-2 mb-md-0">

                    <select id="filterMasterCourse"
                            class="form-select">

                        <option value="">
                            All Master Courses
                        </option>

                        <!-- Master Course options will be loaded from the database.
                        -->

                    </select>

                </div>


                <!-- Sub Course Filter -->
                <div class="col-md-2 mb-2 mb-md-0">

                    <select id="filterSubCourse"
                            class="form-select">

                        <option value="">
                            All Sub Courses
                        </option>

                    </select>

                </div>


                <!-- Add Material -->
                <div class="col-md-2 text-md-end">

                    <button type="button"
                            class="btn btn-primary w-100"
                            onclick="openAddMaterialModal()">

                        + Add Material

                    </button>

                </div>

            </div>


            <!-- TOPIC FILTER -->

            <div class="row mb-3">

                <div class="col-md-3 ms-auto">

                    <select id="filterTopic"
                            class="form-select">

                        <option value="">
                            All Topics
                        </option>

                    </select>

                </div>

            </div>


            <!-- MATERIAL TABLE -->

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle"
                       id="materialTable">

                    <thead class="table-light">

                        <tr>

                            <th style="width:70px;">
                                #
                            </th>

                            <th>
                                Master Course
                            </th>

                            <th>
                                Sub Course
                            </th>

                            <th>
                                Topic
                            </th>

                            <th>
                                Assignment
                            </th>

                            <th>
                                MCQ
                            </th>

                            <th style="width:180px;">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody id="materialTableBody">

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var material in Model)
                            {
                                <tr>

                                    <!-- Serial number -->
                                    <td>
                                        @count
                                    </td>


                                    <!-- Master Course -->
                                    <td>
                                        @material.MasterCourse?.CourseName
                                    </td>


                                    <!-- Sub Course -->
                                    <td>
                                        @material.SubCourse?.SubCourseName
                                    </td>


                                    <!-- Topic -->
                                    <td>
                                        @material.Topic?.TopicName
                                    </td>


                                    <!-- Assignment -->
                                    <td>

                                        @if (!string.IsNullOrEmpty(material.Assignment))
                                        {
                                            <a href="@material.Assignment"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-primary">
                                                View Assignment
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Assignment
                                            </span>
                                        }

                                    </td>


                                    <!-- MCQ count -->
                                    <td>

                                        @{
                                            int mcqCount =
                                                material.Mcqs == null
                                                ? 0
                                                : material.Mcqs.Count;
                                        }

                                        @mcqCount Questions

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <button type="button"
                                                class="btn btn-sm btn-warning me-1"
                                                onclick="editMaterial(@material.Id)">
                                            Edit
                                        </button>


                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                onclick="deleteMaterial(@material.Id)">
                                            Delete
                                        </button>

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center text-muted py-4">

                                    No materials found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION AREA - not complete -->

            <div class="d-flex justify-content-end mt-3">

                <nav>
                    <ul class="pagination mb-0"
                        id="pagination">
                    </ul>
                </nav>

            </div>

        </div>

    </div>

</div>



<!--   ADD / UPDATE MATERIAL MODAL -->

<div class="modal fade"
     id="materialModal"
     tabindex="-1"
     aria-labelledby="materialModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">


            <!-- MODAL HEADER -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="materialModalLabel">

                    Add Material

                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- MODAL BODY -->

            <div class="modal-body">

                <!-- multipart/form-data is required because assignment is uploaded as a file -->
                <form id="materialForm"
                      enctype="multipart/form-data">

                    <!-- Hidden Material ID -->

                    <input type="hidden"
                           id="MaterialId"
                           name="Id"
                           value="0" />


                    <!-- COURSE SECTION -->

                    <div class="card mb-4">

                        <div class="card-header">
                            <strong>Material Information</strong>
                        </div>

                        <div class="card-body">

                            <div class="row">

                                <!-- Master Course -->

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Master Course
                                    </label>

                                    <select id="MasterCourseId"
                                            name="MasterCourseId"
                                            class="form-select">

                                        <option value="">
                                            -- Select Master Course --
                                        </option>
                                        
                                        @if (ViewBag.MasterCourseList != null)
                                        {
                                            foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.MasterCourseList)
                                            {
                                                <option value="@item.Value">
                                                    @item.Text
                                                </option>
                                            }
                                        }

                                    </select>

                                </div>


                                <!-- Sub Course -->

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Sub Course
                                    </label>

                                    <select id="SubCourseId"
                                            name="SubCourseId"
                                            class="form-select">

                                        <option value="">
                                            -- Select Sub Course --
                                        </option>

                                    </select>

                                </div>


                                <!-- Topic -->

                                <div class="col-md-4 mb-3">

                                    <label class="form-label">
                                        Topic
                                    </label>

                                    <select id="TopicId"
                                            name="TopicId"
                                            class="form-select">

                                        <option value="">
                                            -- Select Topic --
                                        </option>

                                    </select>

                                </div>


                                <!-- Assignment -->

                                <div class="col-md-8 mb-3">

                                    <label class="form-label">
                                        Assignment Attachment
                                    </label>

                                    <input type="file"
                                           id="assignmentFile"
                                           name="assignmentFile"
                                           class="form-control" />

                                    <!-- Existing assignment -->
                                    <div id="currentAssignment"
                                         class="mt-2"
                                         style="display:none;">
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         MCQ SECTION
                         ================================================= -->

                    <div class="card">

                        <div class="card-header d-flex justify-content-between align-items-center">

                            <strong>
                                MCQ Questions
                            </strong>


                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    onclick="addMcqQuestion()">

                                + Add Question

                            </button>

                        </div>


                        <div class="card-body">

                            <!-- JavaScript will dynamically create - Question 1, Question 2, Question 3... -->

                            <div id="mcqContainer">
                            </div>


                            <!-- Message shown when there are no questions -->

                            <div id="noMcqMessage"
                                 class="text-center text-muted py-3">

                                No questions added.
                                Click "Add Question" to create an MCQ.

                            </div>

                        </div>

                    </div>


                </form>

            </div>


            <!--  MODAL FOOTER -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <button type="button"
                        id="btnSaveMaterial"
                        class="btn btn-primary"
                        onclick="saveMaterial()">

                    Save Material

                </button>

            </div>

        </div>

    </div>

</div>



@section Scripts
{
    <script>

        
        // GLOBAL MCQ COUNTER
        // 

        var mcqIndex = 0;



        
        // PAGE LOAD
        
        $(document).ready(function() {

            // Load active Master Courses into the
            // Add Material dropdown
            loadMasterCourses();

        });



        
        // LOAD MASTER COURSES
        // 
        // The current MaterialController does not yet expose a
        // separate GetMasterCourses() method.
        //
        // Therefore, for the first implementation we will load
        // the values from the page later through ViewBag.
        //
        // This function is intentionally kept here so that the
        // dropdown logic is separated from the rest of the code.
        // 

        function loadMasterCourses() {

            // We will populate this from ViewBag / controller
            // in the next controller update if required.

        }



        
        // MASTER COURSE -> SUB COURSE
        //

        $("#MasterCourseId").change(function() {

            var masterCourseId =
                $(this).val();


            var subCourseDropdown =
                $("#SubCourseId");


            var topicDropdown =
                $("#TopicId");


            // Reset Sub Course.
            subCourseDropdown.empty();

            subCourseDropdown.append(
                '<option value="">-- Select Sub Course --</option>'
            );


            // Reset Topic
            topicDropdown.empty();

            topicDropdown.append(
                '<option value="">-- Select Topic --</option>'
            );


            if (!masterCourseId) {

                return;

            }


            $.ajax({

                url: '@Url.Action("GetSubCourses", "Material")',

                type: 'GET',

                data: {
                    masterCourseId: masterCourseId
                },

                success: function(data) {

                    $.each(data, function(index, item) {

                        subCourseDropdown.append(

                            '<option value="' +
                            item.id +
                            '">' +
                            item.name +
                            '</option>'

                        );

                    });

                },

                error: function() {

                    alert("Unable to load Sub Courses.");

                }

            });

        });



        // 
        // SUB COURSE -> TOPIC
        //

        $("#SubCourseId").change(function() {

            var subCourseId =
                $(this).val();


            var topicDropdown =
                $("#TopicId");


            topicDropdown.empty();


            topicDropdown.append(
                '<option value="">-- Select Topic --</option>'
            );


            if (!subCourseId) {

                return;

            }


            $.ajax({

                url: '@Url.Action("GetTopics", "Material")',

                type: 'GET',

                data: {
                    subCourseId: subCourseId
                },

                success: function(data) {

                    $.each(data, function(index, item) {

                        topicDropdown.append(

                            '<option value="' +
                            item.id +
                            '">' +
                            item.name +
                            '</option>'

                        );

                    });

                },

                error: function() {

                    alert("Unable to load Topics.");

                }

            });

        });



        
        // OPEN ADD MATERIAL MODAL
        // 

        function openAddMaterialModal() {

            resetMaterialForm();


            $("#materialModalLabel")
                .text("Add Material");


            $("#btnSaveMaterial")
                .text("Save Material");


            var modalElement =
                document.getElementById("materialModal");


            var modal =
                bootstrap.Modal
                    .getOrCreateInstance(modalElement);


            modal.show();

        }



        // 
        // ADD MCQ QUESTION
        // 
        // Creates a new Question block dynamically
        //
        // The generated field names are important:
        //
        // mcqs[0].Question
        // mcqs[0].Option1
        // mcqs[0].Option2
        // 
        //
        // This allows ASP.NET Core model binding to create:
        // List<Mcq> mcqs
        //
        // in MaterialController.
        // 

        function addMcqQuestion() {

            var currentIndex =
                mcqIndex;


            mcqIndex++;


            $("#noMcqMessage")
                .hide();


            var html = `

                        <div class="card mb-3 mcq-item"
                             data-index="${currentIndex}">

                            <div class="card-header d-flex justify-content-between">

                                <strong>
                                    Question ${currentIndex + 1}
                                </strong>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="removeMcqQuestion(this)">

                                    Remove

                                </button>

                            </div>


                            <div class="card-body">

                                <div class="mb-3">

                                    <label class="form-label">
                                        Question
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           name="mcqs[${currentIndex}].Question"
                                           placeholder="Enter question" />

                                </div>


                                <div class="row">

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option 1
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               name="mcqs[${currentIndex}].Option1"
                                               placeholder="Enter option 1" />

                                    </div>


                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option 2
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               name="mcqs[${currentIndex}].Option2"
                                               placeholder="Enter option 2" />

                                    </div>


                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option 3
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               name="mcqs[${currentIndex}].Option3"
                                               placeholder="Enter option 3" />

                                    </div>


                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option 4
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               name="mcqs[${currentIndex}].Option4"
                                               placeholder="Enter option 4" />

                                    </div>

                                </div>


                                <div class="mb-0">

                                    <label class="form-label">
                                        Correct Answer
                                    </label>

                                    <select class="form-select"
                                            name="mcqs[${currentIndex}].Answer">

                                        <option value="">
                                            -- Select Correct Answer --
                                        </option>

                                        <option value="Option 1">
                                            Option 1
                                        </option>

                                        <option value="Option 2">
                                            Option 2
                                        </option>

                                        <option value="Option 3">
                                            Option 3
                                        </option>

                                        <option value="Option 4">
                                            Option 4
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>

                    `;


            $("#mcqContainer")
                .append(html);

        }



        
        // REMOVE MCQ
        // 

        function removeMcqQuestion(button) {

            $(button)
                .closest(".mcq-item")
                .remove();


            // Show message if no questions remain.
            if (
                $("#mcqContainer .mcq-item").length === 0
            ) {

                $("#noMcqMessage")
                    .show();

            }

        }



        
        // SAVE MATERIAL
        // 

        function saveMaterial() {

            var form =
                document.getElementById("materialForm");


            var formData =
                new FormData(form);


            $.ajax({

                url: '@Url.Action("Add", "Material")',

                type: 'POST',

                data: formData,

                processData: false,

                contentType: false,

                success: function(response) {

                    if (response.success) {

                        alert(
                            "Material added successfully."
                        );


                        var modalElement =
                            document.getElementById("materialModal");


                        var modal =
                            bootstrap.Modal
                                .getOrCreateInstance(modalElement);


                        modal.hide();


                        location.reload();

                    }
                    else {

                        alert(
                            response.message ||
                            "Unable to add Material."
                        );

                    }

                },

                error: function() {

                    alert(
                        "Something went wrong while saving Material."
                    );

                }

            });

        }



        
        // EDIT MATERIAL

        function editMaterial(id) {

            $.ajax({

                url: '@Url.Action("GetById", "Material")',

                type: 'GET',

                data: {
                    id: id
                },

                success: function(material) {

                    if (
                        !material ||
                        material.success === false
                    ) {

                        alert("Material not found.");

                        return;

                    }


                    resetMaterialForm();


                    // Material ID.
                    $("#MaterialId")
                        .val(material.id);


                    // Master Course.
                    $("#MasterCourseId")
                        .val(material.masterCourseId);


                    // Load Sub Courses first.
                    loadSubCoursesForEdit(
                        material.masterCourseId,
                        material.subCourseId,
                        material.topicId
                    );


                    // Existing assignment.
                    if (material.assignment) {

                        $("#currentAssignment")
                            .html(
                                '<a href="' +
                                material.assignment +
                                '" target="_blank">' +
                                'View Current Assignment' +
                                '</a>'
                            )
                            .show();

                    }


                    // Change modal title.
                    $("#materialModalLabel")
                        .text("Update Material");


                    $("#btnSaveMaterial")
                        .text("Update Material");


                    // Open modal.
                    var modalElement =
                        document.getElementById("materialModal");


                    var modal =
                        bootstrap.Modal
                            .getOrCreateInstance(modalElement);


                    modal.show();


                    // Load MCQs.
                    if (
                        material.mcqs &&
                        material.mcqs.length > 0
                    ) {

                        material.mcqs.forEach(function(mcq) {

                            addMcqQuestion();


                            var index =
                                mcqIndex - 1;


                            $(
                                `input[name="mcqs[${index}].Question"]`
                            ).val(mcq.question);


                            $(
                                `input[name="mcqs[${index}].Option1"]`
                            ).val(mcq.option1);


                            $(
                                `input[name="mcqs[${index}].Option2"]`
                            ).val(mcq.option2);


                            $(
                                `input[name="mcqs[${index}].Option3"]`
                            ).val(mcq.option3);


                            $(
                                `input[name="mcqs[${index}].Option4"]`
                            ).val(mcq.option4);


                            $(
                                `select[name="mcqs[${index}].Answer"]`
                            ).val(mcq.answer);

                        });

                    }

                },

                error: function() {

                    alert(
                        "Unable to load Material."
                    );

                }

            });

        }



        
        // LOAD SUB COURSE FOR EDIT
        //

        function loadSubCoursesForEdit(
            masterCourseId,
            selectedSubCourseId,
            selectedTopicId
        ) {

            var subCourseDropdown =
                $("#SubCourseId");


            subCourseDropdown.empty();


            subCourseDropdown.append(
                '<option value="">-- Select Sub Course --</option>'
            );


            $.ajax({

                url: '@Url.Action("GetSubCourses", "Material")',

                type: 'GET',

                data: {
                    masterCourseId: masterCourseId
                },

                success: function(data) {

                    $.each(data, function(index, item) {

                        var selected =
                            item.id == selectedSubCourseId
                                ? "selected"
                                : "";


                        subCourseDropdown.append(

                            '<option value="' +
                            item.id +
                            '" ' +
                            selected +
                            '>' +
                            item.name +
                            '</option>'

                        );

                    });


                    // Load Topics after Sub Course is populated.
                    loadTopicsForEdit(
                        selectedSubCourseId,
                        selectedTopicId
                    );

                },

                error: function() {

                    alert(
                        "Unable to load Sub Courses."
                    );

                }

            });

        }



        
        // LOAD TOPICS FOR EDIT
        // 

        function loadTopicsForEdit(
            subCourseId,
            selectedTopicId
        ) {

            var topicDropdown =
                $("#TopicId");


            topicDropdown.empty();


            topicDropdown.append(
                '<option value="">-- Select Topic --</option>'
            );


            $.ajax({

                url: '@Url.Action("GetTopics", "Material")',

                type: 'GET',

                data: {
                    subCourseId: subCourseId
                },

                success: function(data) {

                    $.each(data, function(index, item) {

                        var selected =
                            item.id == selectedTopicId
                                ? "selected"
                                : "";


                        topicDropdown.append(

                            '<option value="' +
                            item.id +
                            '" ' +
                            selected +
                            '>' +
                            item.name +
                            '</option>'

                        );

                    });

                },

                error: function() {

                    alert(
                        "Unable to load Topics."
                    );

                }

            });

        }



        
        // RESET MATERIAL FORM
        // 

        function resetMaterialForm() {

            $("#materialForm")[0].reset();


            $("#MaterialId")
                .val(0);


            $("#SubCourseId")
                .empty()
                .append(
                    '<option value="">-- Select Sub Course --</option>'
                );


            $("#TopicId")
                .empty()
                .append(
                    '<option value="">-- Select Topic --</option>'
                );


            $("#mcqContainer")
                .empty();


            $("#noMcqMessage")
                .show();


            $("#currentAssignment")
                .hide()
                .html("");


            // Reset MCQ counter.
            mcqIndex = 0;

        }



        
        // DELETE MATERIAL
        // 

        function deleteMaterial(id) {

            if (!confirm(
                "Are you sure you want to delete this Material?"
            )) {

                return;

            }


            $.ajax({

                url: '@Url.Action("Delete", "Material")',

                type: 'POST',

                data: {
                    id: id
                },

                success: function(response) {

                    if (response.success) {

                        alert(
                            "Material deleted successfully."
                        );

                        location.reload();

                    }
                    else {

                        alert(
                            response.message ||
                            "Unable to delete Material."
                        );

                    }

                },

                error: function() {

                    alert(
                        "Something went wrong while deleting Material."
                    );

                }

            });

        }



        
        // SEARCH MATERIALS
        // 

        function searchMaterials() {

            var searchValue =
                $("#searchMaterial")
                    .val()
                    .toLowerCase();


            $("#materialTableBody tr").each(function() {

                var rowText =
                    $(this)
                        .text()
                        .toLowerCase();


                if (
                    rowText.indexOf(searchValue) > -1
                ) {

                    $(this).show();

                }
                else {

                    $(this).hide();

                }

            });

        }

    </script>
}