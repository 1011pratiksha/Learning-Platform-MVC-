@model List<LearningPlatform.Models.SubCourse>
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-collection-play me-2 text-primary"></i>Sub Course</h2>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#subCourseModal" onclick="openAddModal()">
            <i class="bi bi-plus-circle"></i> Add Sub Course
        </button>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchBox" class="form-control" placeholder="Search sub course..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-mortarboard"></i></span>
                        <select id="filterMasterCourse" class="form-select">
                            <option value="">All Master Courses</option>
                            @foreach (var m in Model.Select(s => s.MasterCourse.CourseName).Distinct())
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-toggle-on"></i></span>
                        <select id="filterStatus" class="form-select">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover align-middle mb-0" id="subCourseTable" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Master Course</th>
                        <th>Sub Course</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Created By</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.MasterCourse.CourseName</td>
                            <td>@item.SubCourseName</td>
                            <td>₹@item.Amount</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                                }
                            </td>
                            <td>@item.CreatedAt</td>
                            <td>@item.CreatedBy</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-1" data-bs-toggle="modal" data-bs-target="#subCourseModal" onclick="editSubCourse(@item.Id)" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="deleteSubCourse(@item.Id)" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="subCourseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"><i class="bi bi-plus-circle me-2"></i>Add Sub Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="subCourseForm">
                    <input type="hidden" id="Id" name="Id" />

                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-mortarboard me-1"></i>Master Course</label>
                        <select class="form-select" id="MasterCourseId" name="MasterCourseId">
                            @foreach (var m in (SelectList)ViewBag.MasterCourseList)
                            {
                                <option value="@m.Value">@m.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-journal-text me-1"></i>Sub Course</label>
                        <input type="text" class="form-control" id="SubCourseName" name="SubCourseName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-currency-rupee me-1"></i>Amount</label>
                        <input type="number" step="0.01" class="form-control" id="Amount" name="Amount" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="bi bi-toggle-on me-1"></i>Status</label>
                        <select class="form-select" id="Status" name="Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary d-flex align-items-center gap-2" onclick="saveSubCourse()">
                    <i class="bi bi-save"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#subCourseTable').DataTable({
                order: [[5, 'desc']],          // default sort: Created At, desc
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                columnDefs: [
                    { orderable: false, targets: 7 }   // disable sorting on Action column
                ]
            });

            // Global search box
            $('#searchBox').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Filter by Master Course (column index 1)
            $('#filterMasterCourse').on('change', function () {
                var val = $.fn.dataTable.util.escapeRegex($(this).val());
                table.column(1).search(val ? '^' + val + '$' : '', true, false).draw();
            });

            // Filter by Status (column index 4)
            $('#filterStatus').on('change', function () {
                table.column(4).search(this.value).draw();
            });
        });

        function openAddModal() {
            document.getElementById("modalTitle").innerText = "Add Sub Course";
            document.getElementById("subCourseForm").reset();
            document.getElementById("Id").value = "";
        }

        function saveSubCourse() {
            var id = document.getElementById("Id").value;
            var url = id ? "/SubCourse/Update" : "/SubCourse/Add";

            var data = {
                Id: id,
                MasterCourseId: document.getElementById("MasterCourseId").value,
                SubCourseName: document.getElementById("SubCourseName").value,
                Amount: document.getElementById("Amount").value,
                Status: document.getElementById("Status").value
            };

            fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    alert("Something went wrong.");
                }
            });
        }

        function editSubCourse(id) {
            fetch("/SubCourse/GetById?id=" + id)
                .then(response => response.json())
                .then(data => {
                    document.getElementById("modalTitle").innerText = "Edit Sub Course";
                    document.getElementById("Id").value = data.id;
                    document.getElementById("MasterCourseId").value = data.masterCourseId;
                    document.getElementById("SubCourseName").value = data.subCourseName;
                    document.getElementById("Amount").value = data.amount;
                    document.getElementById("Status").value = data.status;
                });
        }

        function deleteSubCourse(id) {
            if (confirm("Are you sure you want to delete this sub course?")) {
                fetch("/SubCourse/Delete?id=" + id, {
                    method: "POST"
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        location.reload();
                    }
                });
            }
        }
    </script>
}