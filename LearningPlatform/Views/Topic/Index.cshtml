@model IEnumerable<LearningPlatform.Models.Topic>

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Topic";
}

<div class="container-fluid py-4">

    <!-- Page Header-->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Topic</h2>
            <p class="text-muted mb-0">
                Manage learning platform topics.
            </p>
        </div>
    </div>


    <!-- Topic List -->
    <div class="card shadow-sm">

        <div class="card-body">

            <!-- table header search and add buttons -->
            <div class="row align-items-center mb-3">

                <div class="col-md-6">
                    <h5 class="mb-0">
                        Topic List
                    </h5>
                </div>

                <div class="col-md-6">

                    <div class="d-flex justify-content-md-end gap-2">

                        <!-- Search -->
                        <input type="text"
                               id="searchTopic"
                               class="form-control"
                               placeholder="Search topic..."
                               onkeyup="searchTopics()" />

                        <!-- Add button.The form is not visible on the main page after clicking this button opens the Bootstrap modal
                        -->
                        <button type="button"
                                class="btn btn-primary"
                                onclick="openAddModal()">
                            Add
                        </button>

                    </div>

                </div>

            </div>


            <!-- topic table -->

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle"
                       id="topicTable">

                    <thead class="table-light">

                        <tr>

                            <th>ID</th>

                            <th>Master Course</th>

                            <th>Sub Course</th>

                            <th>Topic</th>

                            <th>Video URL</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody id="topicTableBody">

                        @if (Model != null && Model.Any())
                        {
                            foreach (var topic in Model)
                            {
                                <tr>

                                    <td>
                                        @topic.Id
                                    </td>

                                    <td>
                                        @topic.MasterCourse?.CourseName
                                    </td>

                                    <td>
                                        @topic.SubCourse?.SubCourseName
                                    </td>

                                    <td>
                                        @topic.TopicName
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrEmpty(topic.VideoUrl))
                                        {
                                            <a href="@topic.VideoUrl"
                                               target="_blank">
                                                View Video
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Video
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (topic.Status)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <button type="button"
                                                class="btn btn-sm btn-warning me-1"
                                                onclick="editTopic(@topic.Id)">
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                onclick="deleteTopic(@topic.Id)">
                                            Delete
                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noDataRow">

                                <td colspan="7"
                                    class="text-center text-muted py-4">

                                    No topics found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!--paginaion use LINQ Skip() and Take() - not completed -->

            <div class="d-flex justify-content-end mt-3">

                <nav>
                    <ul class="pagination mb-0"
                        id="pagination">
                    </ul>
                </nav>

            </div>

        </div>

    </div>

</div>



<!-- add and update topic modal -->

<div class="modal fade"
     id="topicModal"
     tabindex="-1"
     aria-labelledby="topicModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <!-- modal header -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="topicModalLabel">
                    Add Topic
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- modal body -->

            <div class="modal-body">

                <!-- multipart/form-data is required because the form contains a thumbnail file upload -->
                <form id="topicForm"
                      enctype="multipart/form-data">

                    <!-- Hidden Topic ID if 0 = Add mode for Existing ID = Edit/Update mode  -->
                    <input type="hidden"
                           id="Id"
                           name="Id"
                           value="0" />


                    <div class="row">

                        <!-- Master course -->

                        <div class="col-md-6 mb-3">

                            <label for="MasterCourseId"
                                   class="form-label">
                                Master Course
                            </label>

                            <select id="MasterCourseId"
                                    name="MasterCourseId"
                                    class="form-select">

                                <option value="">
                                    -- Select MasterCourse --
                                </option>

                                @if (ViewBag.MasterCourseList != null)
                                {
                                    foreach (var item in (SelectList)ViewBag.MasterCourseList)
                                    {
                                        <option value="@item.Value">
                                            @item.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!--sub course -->

                        <div class="col-md-6 mb-3">

                            <label for="SubCourseId"
                                   class="form-label">
                                Sub Course
                            </label>

                            <select id="SubCourseId"
                                    name="SubCourseId"
                                    class="form-select">

                                <option value="">
                                    -- Select SubCourse --
                                </option>

                            </select>

                        </div>


                        <!-- topic name -->

                        <div class="col-md-6 mb-3">

                            <label for="TopicName"
                                   class="form-label">
                                Topic Name
                            </label>

                            <input type="text"
                                   id="TopicName"
                                   name="TopicName"
                                   class="form-control"
                                   placeholder="Enter topic name" />

                        </div>


                        <!-- video URL -->

                        <div class="col-md-6 mb-3">

                            <label for="VideoUrl"
                                   class="form-label">
                                Video URL
                            </label>

                            <input type="text"
                                   id="VideoUrl"
                                   name="VideoUrl"
                                   class="form-control"
                                   placeholder="Enter topic video URL" />

                        </div>


                        <!-- Status -->

                        <div class="col-md-6 mb-3">

                            <label for="Status"
                                   class="form-label">
                                Status
                            </label>

                            <select id="Status"
                                    name="Status"
                                    class="form-select">

                                <option value="true">
                                    Active
                                </option>

                                <option value="false">
                                    Inactive
                                </option>

                            </select>

                        </div>


                        <!-- tumbnail -->

                        <div class="col-md-6 mb-3">

                            <label for="thumbnail"
                                   class="form-label">
                                Thumbnail
                            </label>

                            <input type="file"
                                   id="thumbnail"
                                   name="thumbnail"
                                   class="form-control"
                                   accept="image/*" />


                            <!-- Existing thumbnail shown during Edit -->
                            <div class="mt-2"
                                 id="thumbnailPreviewContainer"
                                 style="display:none;">

                                <small class="text-muted d-block mb-1">
                                    Current Thumbnail
                                </small>

                                <img id="thumbnailPreview"
                                     src=""
                                     alt="Topic Thumbnail"
                                     style="width:100px;
                                height:70px;
                                object-fit:cover;
                                border-radius:5px;" />

                            </div>

                        </div>

                    </div>

                </form>

            </div>


            <!-- modal footer -->

            <div class="modal-footer">

                <!-- Close button -->
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>


                <!-- Add button -->
                <button type="button"
                        id="btnAdd"
                        class="btn btn-primary"
                        onclick="addTopic()">
                    Add
                </button>


                <!-- Update button -->
                <button type="button"
                        id="btnUpdate"
                        class="btn btn-success"
                        style="display:none;"
                        onclick="updateTopic()">
                    Update
                </button>

            </div>

        </div>

    </div>

</div>



@section Scripts
{
    <script>

        //open add modal

        function openAddModal() {

            // Reset the form to blank values
            resetForm();

            // Change modal title
            $("#topicModalLabel").text("Add Topic");

            // Show Add button
            $("#btnAdd").show();

            // Hide Update button
            $("#btnUpdate").hide();


            // Open Bootstrap modal
            var modalElement =
                document.getElementById("topicModal");

            var modal =
                bootstrap.Modal.getOrCreateInstance(modalElement);

            modal.show();
        }



        // master course -> sub course
        // When Admin selects a Master Course we request its
        // Sub Courses from TopicController

        $("#MasterCourseId").change(function() {

            var masterCourseId = $(this).val();

            var subCourseDropdown =
                $("#SubCourseId");


            // Remove previous Sub Course options
            subCourseDropdown.empty();


            // Add default option again
            subCourseDropdown.append(
                '<option value="">-- Select Sub Course --</option>'
            );


            // If Admin has not selected a Master Course stop here
            if (!masterCourseId) {

                return;
            }


            $.ajax({

                url: '@Url.Action("GetSubCourses", "Topic")',

                type: 'GET',

                data: {
                    masterCourseId: masterCourseId
                },

                success: function(data) {

                    // Add every returned Sub Course
                    // to dropdown
                    $.each(data, function(index, item) {

                        subCourseDropdown.append(

                            '<option value="' +
                            item.id +
                            '">' +
                            item.name +
                            '</option>'

                        );

                    });

                },

                error: function() {

                    alert("Unable to load Sub Courses.");

                }

            });

        });


    //Add topic

        function addTopic() {

            var form =
                document.getElementById("topicForm");


            // FormData is required because the form
            // contains a thumbnail file
            var formData =
                new FormData(form);


            $.ajax({

                url: '@Url.Action("Add", "Topic")',

                type: 'POST',

                data: formData,

                processData: false,

                contentType: false,

                success: function(response) {

                    if (response.success) {

                        alert(
                            "Topic added successfully."
                        );


                        // Close modal after successful add
                        var modalElement = document.getElementById("topicModal");

                        var modal = bootstrap.Modal
                                .getOrCreateInstance(modalElement);

                        modal.hide();


                        // Reload so the new Topic appears
                        location.reload();

                    }
                    else {

                        alert(
                            response.message ||
                            "Unable to add Topic."
                        );

                    }

                },

                error: function() {

                    alert(
                        "Something went wrong while adding the Topic."
                    );

                }

            });

        }



        //Edit topic

        function editTopic(id) {

            $.ajax({

                url: '@Url.Action("GetById", "Topic")',

                type: 'GET',

                data: {
                    id: id
                },

                success: function(topic) {

                    if (!topic) {

                        alert("Topic not found.");

                        return;
                    }


                    // Fill Topic ID
                    $("#Id").val(topic.id);


                    // Select Master Course
                    $("#MasterCourseId")
                        .val(topic.masterCourseId);


                    // Load Sub Courses and select
                    // the existing Sub Course
                    loadSubCoursesForEdit(
                        topic.masterCourseId,
                        topic.subCourseId
                    );


                    // Fill remaining values
                    $("#TopicName")
                        .val(topic.topicName);

                    $("#VideoUrl")
                        .val(topic.videoUrl);

                    $("#Status")
                        .val(
                            topic.status
                                .toString()
                                .toLowerCase()
                        );


                    // Show existing thumbnail
                    if (topic.thumbnailPath) {

                        $("#thumbnailPreview")
                            .attr(
                                "src",
                                topic.thumbnailPath
                            );

                        $("#thumbnailPreviewContainer")
                            .show();

                    }
                    else {

                        $("#thumbnailPreviewContainer")
                            .hide();

                    }


                    // Change modal title
                    $("#topicModalLabel")
                        .text("Update Topic");


                    // Hide Add
                    $("#btnAdd").hide();


                    // Show Update
                    $("#btnUpdate").show();


                    // Open modal
                    var modalElement =
                        document.getElementById("topicModal");

                    var modal =
                        bootstrap.Modal
                            .getOrCreateInstance(modalElement);

                    modal.show();

                },

                error: function() {

                    alert("Unable to load Topic.");

                }

            });

        }



        //load subcourses during edit
        function loadSubCoursesForEdit(
            masterCourseId,
            selectedSubCourseId
        ) {

            var subCourseDropdown =
                $("#SubCourseId");


            subCourseDropdown.empty();


            subCourseDropdown.append(
                '<option value="">-- Select Sub Course --</option>'
            );


            if (!masterCourseId) {

                return;
            }


            $.ajax({

                url: '@Url.Action("GetSubCourses", "Topic")',

                type: 'GET',

                data: {
                    masterCourseId: masterCourseId
                },

                success: function(data) {

                    $.each(data, function(index, item) {

                        var selected = "";


                        // Select the existing Sub Course
                        // while editing
                        if (
                            item.id == selectedSubCourseId
                        ) {

                            selected = "selected";

                        }


                        subCourseDropdown.append(

                            '<option value="' +
                            item.id +
                            '" ' +
                            selected +
                            '>' +
                            item.name +
                            '</option>'

                        );

                    });

                },

                error: function() {

                    alert("Unable to load Sub Courses.");

                }

            });

        }



        // Update topic

        function updateTopic() {

            var form =
                document.getElementById("topicForm");


            var formData =
                new FormData(form);


            $.ajax({

                url: '@Url.Action("Update", "Topic")',

                type: 'POST',

                data: formData,

                processData: false,

                contentType: false,

                success: function(response) {

                    if (response.success) {

                        alert(
                            "Topic updated successfully."
                        );


                        // Close the modal
                        var modalElement =
                            document.getElementById("topicModal");

                        var modal =
                            bootstrap.Modal
                                .getOrCreateInstance(modalElement);

                        modal.hide();


                        // Reload the table
                        location.reload();

                    }
                    else {

                        alert(
                            response.message ||
                            "Unable to update Topic."
                        );

                    }

                },

                error: function() {

                    alert(
                        "Something went wrong while updating the Topic."
                    );

                }

            });

        }



        // delete topic

        function deleteTopic(id) {

            if (!confirm(
                "Are you sure you want to delete this Topic?"
            )) {

                return;
            }


            $.ajax({

                url: '@Url.Action("Delete", "Topic")',

                type: 'POST',

                data: {
                    id: id
                },

                success: function(response) {

                    if (response.success) {

                        alert(
                            "Topic deleted successfully."
                        );

                        location.reload();

                    }
                    else {

                        // Controller may return a message when
                        // Material or MCQ records are associated
                        // with this Topic
                        alert(
                            response.message ||
                            "Unable to delete Topic."
                        );

                    }

                },

                error: function() {

                    alert(
                        "Something went wrong while deleting the Topic."
                    );

                }

            });

        }



        // reset form

        function resetForm() {

            // Clear all form fields
            $("#topicForm")[0].reset();


            // Reset hidden ID to 0
            // 0 means Add mode
            $("#Id").val(0);


            // Reset Sub Course dropdown
            $("#SubCourseId").empty();

            $("#SubCourseId").append(
                '<option value="">-- Select Sub Course --</option>'
            );


            // Hide existing thumbnail preview
            $("#thumbnailPreviewContainer")
                .hide();


            // Remove old thumbnail image
            $("#thumbnailPreview")
                .attr("src", "");


            // Reset modal title
            $("#topicModalLabel")
                .text("Add Topic");


            // Add mode
            $("#btnAdd").show();

            $("#btnUpdate").hide();

        }



        // Search for topic

        function searchTopics() {

            var searchValue =
                $("#searchTopic")
                    .val()
                    .toLowerCase();


            $("#topicTableBody tr").each(function() {

                var rowText =
                    $(this)
                        .text()
                        .toLowerCase();


                if (
                    rowText.indexOf(searchValue) > -1
                ) {

                    $(this).show();

                }
                else {

                    $(this).hide();

                }

            });

        }

    </script>
}